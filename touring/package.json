{
  "name": "oncue-touring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "On Cue: Touring — local-first shared ShowRecord workspace (LED Map, Signal Flow, Rack Build, Media Servers, Show Binder, Advance).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "build:artifact": "vite build -c vite.artifact.config.ts && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "fake-indexeddb": "^6.0.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.1.8"
  }
}
