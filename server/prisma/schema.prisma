// OnCue: Advance — Phase 2 relational core.
//
// Design notes (see README.md "Phase 2 Architecture" for the full rationale):
// - Every top-level operational entity carries id/status/createdAt/updatedAt/createdBy/updatedBy.
// - Comments, Attachments, and Tags are polymorphic (entityType + entityId) so any entity can be
//   commented on, tagged, or have files attached without a join table per entity. Where an entity
//   is actually wired into the UI this pass (Requirement, Issue), a direct nullable FK is added
//   alongside the polymorphic pair so Postgres can enforce cascade-delete integrity for it.
// - AuditLog is polymorphic and written by the API layer on every create/update/delete of a core
//   entity — see server/src/audit.ts.
// - Department is a shared enum reused across Requirement/Task/Issue/CrewMember/Equipment so the
//   Requirement Matrix (Phase 2 Module 2) can generalize across every touring department instead
//   of needing a bespoke table per department (Phase 1's approach).
// - Contact is a single polymorphic model (Venue + Vendor contacts) rather than two near-identical
//   tables, matching the "Relationships" entity in the spec.
// - Drawing Manager (Module 9) is NOT a dedicated table this pass — drawings are Attachments typed
//   by mimeType. Vendor/Transportation/Hotel/Equipment/Communication/Approval/Deliverable/CrewMember
//   models exist for relational completeness but have no dedicated UI yet (see README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RecordStatus {
  CONFIRMED
  NEEDS_REVIEW
  MISSING
  NOT_STARTED
}

enum Department {
  VIDEO
  LIGHTING
  AUDIO
  RIGGING
  AUTOMATION
  BACKLINE
  PRODUCTION
  MERCH
  TRANSPORTATION
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum IssueSeverity {
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TimelineEntryStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  BLOCKED
  SKIPPED
}

enum ShowStatus {
  PLANNING
  ADVANCING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  UPLOADED
  NOT_UPLOADED
  NOT_APPLICABLE
}

enum CommunicationChannel {
  EMAIL
  PHONE
  SLACK
  TEAMS
  WHATSAPP
  SMS
  MEETING
}

enum TravelMode {
  FLIGHT
  TRUCK
  BUS
  RENTAL_CAR
  GROUND
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Categories for show-level advance notes (Comment.category).
enum NoteCategory {
  GENERAL
  PRODUCTION_CONCERN
  VENUE_LIMITATION
  FOLLOW_UP_QUESTION
  INTERNAL_CREW_NOTE
}

/// Workflow status for show-level advance notes (Comment.noteStatus).
enum NoteStatus {
  OPEN
  MONITORING
  RESOLVED
}

/// Used by Comment / Attachment / Tag (EntityTag) / AuditLog to point at any entity
/// without a join table per entity type.
enum EntityType {
  TOUR
  VENUE
  CONTACT
  SHOW
  REQUIREMENT
  TASK
  ISSUE
  TIMELINE_ENTRY
  DOCUMENT
  VENDOR
  CREW_MEMBER
  COMMUNICATION
  APPROVAL
  DELIVERABLE
  EQUIPMENT
  TRAVEL_LEG
  HOTEL_BOOKING
  SCHEDULE_ITEM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id         String  @id @default(uuid())
  email      String  @unique
  name       String
  role       String  @default("crew")
  supabaseId String? @unique
  isAdmin    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedRequirements    Requirement[]       @relation("RequirementOwner")
  ownedIssues          Issue[]             @relation("IssueOwner")
  ownedTasks           Task[]              @relation("TaskOwner")
  ownedTimelineEntries ShowTimelineEntry[] @relation("TimelineOwner")
  ownedScheduleItems   ScheduleItem[]      @relation("ScheduleOwner")
  advancingShows       Show[]              @relation("ShowAdvanceOwner")
  comments             Comment[]
  auditLogs            AuditLog[]
}

// ---------------------------------------------------------------------------
// Tour / Venue / Show
// ---------------------------------------------------------------------------

model Tour {
  id     String       @id @default(uuid())
  name   String
  artist String
  season String
  status RecordStatus @default(NOT_STARTED)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shows Show[]
  tags  EntityTag[]
}

model Venue {
  id          String @id @default(uuid())
  name        String
  address     String @default("")
  latitude    Float?
  longitude   Float?
  timezone    String @default("")
  capacity    Int?
  website     String @default("")
  venueType   String @default("")
  loadInNotes String @default("")

  // Department notes (Module 1 — General/Departments)
  videoNotes      String @default("")
  lightingNotes   String @default("")
  audioNotes      String @default("")
  riggingNotes    String @default("")
  automationNotes String @default("")
  backlineNotes   String @default("")
  productionNotes String @default("")

  // Loading dock
  dockAccess    String  @default("")
  truckCapacity String  @default("")
  dockHeight    String  @default("")
  hasRamp       Boolean @default(false)
  hasForklift   Boolean @default(false)

  // Power
  powerServiceType String @default("")
  powerVoltage     String @default("")
  camlocks         String @default("")
  companySwitch    String @default("")
  generatorNotes   String @default("")

  // Rigging
  riggingPoints     String @default("")
  weightLimits      String @default("")
  roofCapacity      String @default("")
  motorRestrictions String @default("")
  houseRiggingNotes String @default("")

  // FOH / signal environment
  fohCablePath    String @default("")
  fohDistance     String @default("")
  fohMixPosition  String @default("")
  fohPlatform     String @default("")
  fiberRoute      String @default("")
  cameraLocations String @default("")

  // Internet
  wifiAvailable    Boolean @default(false)
  dedicatedNetwork Boolean @default(false)
  fiberAvailable   Boolean @default(false)
  internetNotes    String  @default("")

  // Parking
  truckParking String @default("")
  busParking   String @default("")
  crewParking  String @default("")

  // Nearby logistics
  preferredHotelsNotes String @default("")
  airportDistance      String @default("")
  groundTransportNotes String @default("")

  // Historical weather risk (manual entry this pass — no live weather API)
  windRisk     RiskLevel @default(LOW)
  heatRisk     RiskLevel @default(LOW)
  rainRisk     RiskLevel @default(LOW)
  weatherNotes String    @default("")

  notes String @default("")

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shows    Show[]
  issues   Issue[]
  contacts Contact[]
  tags     EntityTag[]
}

/// Polymorphic contact — used for both Venue contacts (Production, Operations,
/// Rigging, House Electrician, House Video, Security, Loading Dock) and Vendor
/// contacts, rather than two near-identical tables.
model Contact {
  id    String @id @default(uuid())
  name  String
  role  String @default("")
  email String @default("")
  phone String @default("")
  notes String @default("")

  entityType EntityType
  entityId   String

  venueId  String?
  venue    Venue?  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
}

model Show {
  id      String  @id @default(uuid())
  tourId  String
  tour    Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  date      DateTime
  city      String
  state     String
  loadIn    String     @default("")
  doors     String     @default("")
  showTime  String     @default("")
  curfew    String     @default("")
  crewCount Int        @default(0)
  status    ShowStatus @default(PLANNING)

  advanceOwnerId String?
  advanceOwner   User?   @relation("ShowAdvanceOwner", fields: [advanceOwnerId], references: [id])

  // Last AI Risk Engine result (see services/ai/RiskEngine.ts) — cached so the
  // dashboard can render a score without re-calling the model on every load.
  riskScore      Int?
  riskSummary    Json?
  riskAnalyzedAt DateTime?

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements    Requirement[]
  tasks           Task[]
  issues          Issue[]
  timelineEntries ShowTimelineEntry[]
  scheduleItems   ScheduleItem[]
  documents       Document[]
  crewAssignments CrewAssignment[]
  travelLegs      TravelLeg[]
  hotelBookings   HotelBooking[]
  approvals       Approval[]
  deliverables    Deliverable[]
  communications  Communication[]
  comments        Comment[]
  tags            EntityTag[]

  @@index([tourId])
  @@index([venueId])
}

// ---------------------------------------------------------------------------
// Module 2 — Production Requirement Matrix
// ---------------------------------------------------------------------------

model Requirement {
  id     String @id @default(uuid())
  showId String
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  department     Department
  name           String
  description    String         @default("")
  required       Boolean        @default(true)
  providedBy     String         @default("")
  confirmed      Boolean        @default(false)
  status         RecordStatus   @default(NOT_STARTED)
  ownerId        String?
  owner          User?          @relation("RequirementOwner", fields: [ownerId], references: [id])
  dueDate        DateTime?
  priority       Priority       @default(MEDIUM)
  riskLevel      RiskLevel      @default(LOW)
  notes          String         @default("")
  approvalStatus ApprovalStatus @default(NOT_REQUIRED)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       Task[]
  comments    Comment[]
  attachments Attachment[]
  tags        EntityTag[]

  @@index([showId, department])
}

model Task {
  id            String       @id @default(uuid())
  showId        String?
  show          Show?        @relation(fields: [showId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  title       String
  description String       @default("")
  department  Department?
  ownerId     String?
  owner       User?        @relation("TaskOwner", fields: [ownerId], references: [id])
  dueDate     DateTime?
  status      RecordStatus @default(NOT_STARTED)
  priority    Priority     @default(MEDIUM)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([showId])
}

// ---------------------------------------------------------------------------
// Module 8 — Issue Tracking
// ---------------------------------------------------------------------------

model Issue {
  id      String @id @default(uuid())
  showId  String?
  show    Show?   @relation(fields: [showId], references: [id], onDelete: Cascade)
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  title          String
  description    String        @default("")
  department     Department?
  severity       IssueSeverity @default(MODERATE)
  priority       Priority      @default(MEDIUM)
  ownerId        String?
  owner          User?         @relation("IssueOwner", fields: [ownerId], references: [id])
  status         IssueStatus   @default(OPEN)
  resolution     String        @default("")
  lessonsLearned String        @default("")

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments       Comment[]
  attachments    Attachment[]
  tags           EntityTag[]
  communications Communication[]

  @@index([showId])
  @@index([venueId])
}

// ---------------------------------------------------------------------------
// Module 7 — Advance Timeline
// ---------------------------------------------------------------------------

/// Global, ordered list of advance workflow stages — seeded once, shared by every show.
model TimelineStageDefinition {
  id    String @id @default(uuid())
  key   String @unique
  label String
  order Int    @unique

  entries ShowTimelineEntry[]
}

model ShowTimelineEntry {
  id      String                  @id @default(uuid())
  showId  String
  show    Show                    @relation(fields: [showId], references: [id], onDelete: Cascade)
  stageId String
  stage   TimelineStageDefinition @relation(fields: [stageId], references: [id])

  ownerId     String?
  owner       User?                @relation("TimelineOwner", fields: [ownerId], references: [id])
  status      TimelineEntryStatus  @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String               @default("")

  dependsOn  ShowTimelineEntry[] @relation("TimelineDependency")
  dependents ShowTimelineEntry[] @relation("TimelineDependency")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showId, stageId])
}

// ---------------------------------------------------------------------------
// Run of show — carried over from Phase 1; rows are freeform (not a fixed
// enum) so a tour can add non-standard rows in Phase 2.
// ---------------------------------------------------------------------------

model ScheduleItem {
  id     String @id @default(uuid())
  showId String
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  label      String
  time       String       @default("")
  department Department?
  ownerId    String?
  owner      User?        @relation("ScheduleOwner", fields: [ownerId], references: [id])
  notes      String       @default("")
  status     RecordStatus @default(NOT_STARTED)
  sortOrder  Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([showId])
}

// ---------------------------------------------------------------------------
// Documents (Module 11 — placeholder upload, tracked status only)
// ---------------------------------------------------------------------------

model Document {
  id     String @id @default(uuid())
  showId String
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  name   String
  status DocumentStatus @default(NOT_UPLOADED)
  notes  String         @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]
}

// ---------------------------------------------------------------------------
// Schema-only for this pass — modeled for relational completeness, no
// dedicated UI yet (see README "Deferred to Phase 2.2").
// ---------------------------------------------------------------------------

model Vendor {
  id                   String       @id @default(uuid())
  name                 String
  category             String       @default("")
  capabilities         String       @default("")
  pricingNotes         String       @default("")
  leadTimeNotes        String       @default("")
  rentalInventoryNotes String       @default("")
  pastPerformanceNotes String       @default("")
  insuranceOnFile      Boolean      @default(false)
  preferred            Boolean      @default(false)
  status               RecordStatus @default(NOT_STARTED)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts       Contact[]
  communications Communication[]
  tags           EntityTag[]
}

model Communication {
  id         String               @id @default(uuid())
  channel    CommunicationChannel
  subject    String               @default("")
  summary    String               @default("")
  occurredAt DateTime             @default(now())

  showId  String?
  show    Show?       @relation(fields: [showId], references: [id])
  department Department?
  vendorId String?
  vendor   Vendor?    @relation(fields: [vendorId], references: [id])
  issueId  String?
  issue    Issue?     @relation(fields: [issueId], references: [id])

  awaitingResponse Boolean @default(false)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Approval {
  id     String @id @default(uuid())
  showId String
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  department   Department
  name         String
  status       ApprovalStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  notes        String         @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deliverable {
  id     String @id @default(uuid())
  showId String
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  name        String
  type        String       @default("")
  status      RecordStatus @default(NOT_STARTED)
  generatedAt DateTime?
  fileUrl     String       @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrewMember {
  id         String      @id @default(uuid())
  name       String
  role       String      @default("")
  department Department?
  email      String      @default("")
  phone      String      @default("")
  notes      String      @default("")
  isLocal    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments CrewAssignment[]
}

model CrewAssignment {
  id           String     @id @default(uuid())
  showId       String
  show         Show       @relation(fields: [showId], references: [id], onDelete: Cascade)
  crewMemberId String
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  callTime  String  @default("")
  confirmed Boolean @default(false)
  notes     String  @default("")

  @@unique([showId, crewMemberId])
}

model Equipment {
  id           String       @id @default(uuid())
  name         String
  category     String       @default("")
  department   Department?
  serialNumber String       @default("")
  status       RecordStatus @default(NOT_STARTED)
  notes        String       @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TravelLeg {
  id     String @id @default(uuid())
  showId String
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  mode        TravelMode
  description String       @default("")
  departure   String       @default("")
  arrival     String       @default("")
  departureAt DateTime?
  arrivalAt   DateTime?
  status      RecordStatus @default(NOT_STARTED)
  notes       String       @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HotelBooking {
  id     String @id @default(uuid())
  showId String
  show   Show   @relation(fields: [showId], references: [id], onDelete: Cascade)

  hotelName          String
  address            String       @default("")
  distanceToVenue    String       @default("")
  checkIn            DateTime?
  checkOut           DateTime?
  confirmationNumber String       @default("")
  status             RecordStatus @default(NOT_STARTED)
  notes              String       @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Generic relationship primitives — Comments / Attachments / Tags / Audit Log
// ---------------------------------------------------------------------------

/// Doubles as the Phase 1 "Advance Notes" module when entityType = SHOW: a
/// show-level Comment with a `category` and `noteStatus` set behaves like a
/// standalone advance note, while Comments on a Requirement/Issue are plain
/// threaded discussion (category/noteStatus left null). Kept as one model
/// rather than two near-identical ones — both are "a person's note attached
/// to an entity," they just differ in whether they carry a workflow status.
model Comment {
  id         String     @id @default(uuid())
  entityType EntityType
  entityId   String

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id])
  body     String

  category   NoteCategory?
  noteStatus NoteStatus?

  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  issueId       String?
  issue         Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  showId        String?
  show          Show?        @relation(fields: [showId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
}

model Attachment {
  id       String @id @default(uuid())
  fileName String
  mimeType String @default("")
  sizeBytes Int?
  /// Placeholder — no object storage wired up yet (see README). Populated
  /// once real file upload lands.
  url      String @default("")
  uploadedById String?

  entityType EntityType
  entityId   String

  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  issueId       String?
  issue         Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  documentId    String?
  document      Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}

model Tag {
  id    String @id @default(uuid())
  label String @unique
  color String @default("#adff2f")

  entities EntityTag[]
}

model EntityTag {
  id         String     @id @default(uuid())
  tagId      String
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  entityType EntityType
  entityId   String

  tourId        String?
  tour          Tour?        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  venueId       String?
  venue         Venue?       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  showId        String?
  show          Show?        @relation(fields: [showId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  issueId       String?
  issue         Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  vendorId      String?
  vendor        Vendor?      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
}

/// Written by the API layer (see server/src/audit.ts) on every create/update/delete
/// of a core entity. `diff` holds a shallow before/after field diff on UPDATE;
/// `snapshot` holds the full record on CREATE/DELETE.
model AuditLog {
  id         String      @id @default(uuid())
  entityType EntityType
  entityId   String
  action     AuditAction
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  diff       Json?
  snapshot   Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
}
